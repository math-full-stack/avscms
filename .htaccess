# AVSCMS .htaccess
Options -MultiViews
AcceptPathInfo On
RewriteEngine On
RewriteBase /

# Never serve dotfiles / env files (.env carries secrets)
<FilesMatch "^\.(env|env\..+|htaccess|htpasswd)$">
    Require all denied
</FilesMatch>

# If requested resource exists as file or dir, serve it
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Let ajax.php handle its own path-info routing
RewriteCond %{REQUEST_URI} ^/avscms/ajax\.php
RewriteRule ^ - [L]

# Don't rewrite root or index
RewriteCond %{REQUEST_URI} !^/avscms/?$
RewriteCond %{REQUEST_URI} !^/avscms/index(\.php)?/?$ [NC]
# Otherwise forward to loader.php
RewriteRule ^(.*)$ loader.php/\$1 [L,QSA]
