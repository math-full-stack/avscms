# AVSCMS .htaccess - fallback if AllowOverride All is enabled
Options +MultiViews
AcceptPathInfo On
RewriteEngine On
RewriteBase /avscms/

# If requested resource exists as file or dir, serve it
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Don't rewrite root or index
RewriteCond %{REQUEST_URI} !^/avscms/?$
RewriteCond %{REQUEST_URI} !^/avscms/index(\.php)?/?$ [NC]
# Otherwise forward to loader.php (handles /video/16/slug etc)
RewriteRule ^(.*)$ loader.php/$1 [L,QSA]

