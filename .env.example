# ============================================================
# AVSCMS — .env example
# Copy to .env and fill in real values.  Never commit .env.
#
# Where each environment reads it:
#   Local (macOS/XAMPP):   <project-root>/.env  (loaded by include/dotenv.php)
#   VM  (pornozinho-vm):   /etc/avscms/.env     (written by deploy-vm.yml
#                          from GitHub secrets; outside the webroot)
#   Cloud Run:             native env vars (--set-env-vars / secret manager);
#                          deploy.sh fills them from your local .env
#
# Precedence (highest first): real environment > /etc/avscms/.env >
# <project-root>/.env.  include/dotenv.php never overwrites a real env var.
# ============================================================

# ---------- Database ----------
DB_HOST=127.0.0.1
DB_USER=avs_app
DB_PASSWORD=CHANGE_ME
DB_NAME=avs

# ---------- Admin ----------
ADMIN_PASS=CHANGE_ME

# ---------- GCS ----------
GCS_KEY_PATH=/path/to/gcs-service-account.json
GCS_BUCKET=pornozinho-cdn1
GCS_STREAMING_URL=https://storage.googleapis.com/pornozinho-cdn1
# Alternative: paste the JSON key contents directly (Cloud Run / containers).
# GCS_KEY_JSON={"type":"service_account",...}

# ---------- Site ----------
SITE_NAME=Pornozinho
SITE_TITLE=Pornozinho
NOREPLY_EMAIL=noreply@example.com
ADMIN_EMAIL=admin@example.com

# ---------- Paths ----------
PHP_PATH=/usr/bin/php
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
